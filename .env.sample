# 동행복권 계정. 실제 값은 GitHub Actions Secrets에만 저장하세요.
USERNAME=YOUR_ID
PASSWORD=YOUR_PASSWORD

# 구매 설정. GitHub에서는 Settings > Secrets and variables > Actions의 Variables에 저장합니다.
LOTTO645_COUNT=1
BUY_LOTTO645=true
BUY_WIN720=false
CHECK_LOTTO645=true
CHECK_WIN720=true

# 주간 자동구매 상한(원). 로또 1게임은 1,000원, 연금복권720+는 5,000원입니다.
MAX_WEEKLY_SPEND=1000

# 선택 사항. Discord 채널의 Incoming Webhook URL입니다.
DISCORD_WEBHOOK_URL=YOUR_DISCORD_WEBHOOK_URL
